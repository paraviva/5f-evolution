---
import Logo from '../assets/theme-images/echo-logo.svg'

const { settings } = Astro.props
---

<header class="wrapper bg-loop font-semibold">
  <div class="bs-container py-6 flex justify-between items-center">
    
    <a 
      class="flex items-center justify-start group overflow-visible" 
      href="/" 
      aria-label={settings.title + ' - Home'}
    >
      <div class="relative w-40 md:w-64 h-12 flex items-center">
        <Logo 
          class="transition-all duration-300 ease-bs-spring group-hover:scale-105 group-active:scale-125 w-full h-auto"
        />
      </div>
    </a>

    <nav class="hidden md:flex items-center mx-auto lg:gap-2">
      {
        settings.nav.map((item) => (
          <a 
            class="bs-btn bg-transparent! before:translate-y-full hover:before:translate-y-0 px-4 py-2" 
            href={item.link}
          >
            {item.title}
          </a>
        ))
      }
    </nav>

    <button 
      type="button" 
      class="min-w-32 bs-btn cursor-pointer transition-transform active:scale-95" 
      onclick="demo.showModal()"
    >
      {settings.demo.title}
    </button>
  </div>
</header>

<style is:global>
  /* 强制覆盖 SVG 内部可能存在的宽高限制，确保它响应外部容器 */
  svg {
    max-width: 100%;
    height: auto !important;
    display: block;
  }
</style>