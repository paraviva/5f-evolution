---
// 1. 导入图标 (请确保文件名与 src/assets/theme-images/ 下一致)
import xiaohongshuIcon from "../assets/theme-images/xiaohongshu.svg?url";
import tiktokIcon from "../assets/theme-images/tiktok.svg?url";

const currentYear = new Date().getFullYear();
const contactEmail = "info@5fgeo.com"; // 修正后的邮箱

const socialLinks = [
  {
    name: "小红书",
    // 已更换为您提供的新短链接
    url: "https://xhslink.com/m/ok3CfBxSKi", 
    icon: xiaohongshuIcon
  },
  {
    name: "抖音",
    url: "https://v.douyin.com/8_h0aGbr3Iw/",
    icon: tiktokIcon
  }
];
---

<footer class="bg-black py-20 border-t border-white/10 mt-20 text-white font-sans relative">
  <div class="bs-container">
    <div class="flex flex-col lg:flex-row justify-between items-start gap-16">
      
      <div class="flex flex-col gap-6 max-w-sm">
        <a href="/" class="text-3xl font-black tracking-tighter text-white hover:opacity-80 transition-opacity">
           ECHO 5F<span class="text-white">.</span>
        </a>
        <p class="text-white text-sm leading-relaxed tracking-[0.2em] uppercase font-light">
          From Signal to System.
        </p>
      </div>

      <div class="flex flex-col gap-8">
        <h4 class="font-bold tracking-[0.3em] text-[10px] uppercase text-white italic">Brand Social</h4>
        <div class="flex gap-12">
          {socialLinks.map(({ name, url, icon }) => (
            <a href={url} target="_blank" class="group flex flex-col gap-3">
              <div class="flex items-center gap-3 text-white">
                <img 
                  src={icon} 
                  alt={name} 
                  class="w-6 h-6 object-contain brightness-0 invert transition-transform group-hover:scale-110" 
                />
                <span class="text-sm font-bold tracking-tight">{name}</span>
              </div>
            </a>
          ))}
        </div>
      </div>

      <div class="flex flex-col gap-8 text-white">
        <h4 class="font-bold tracking-[0.3em] text-[10px] uppercase text-white italic">Contact</h4>
        <div class="flex flex-col gap-4">
          <a href={`mailto:${contactEmail}`} class="text-sm border-b border-white/20 hover:border-white transition-all py-1">
            {contactEmail}
          </a>
          </div>
      </div>

    </div>

    <div class="mt-24 pt-8 border-t border-white/5 flex flex-col md:flex-row justify-between items-center gap-6">
      <div class="text-[9px] tracking-[0.5em] text-white text-center md:text-left uppercase font-light">
        © {currentYear} ECHO 5F. ALL RIGHTS RESERVED.
      </div>

      <button 
        id="back-to-top" 
        class="group flex items-center gap-3 text-white/50 hover:text-white transition-colors cursor-pointer"
        aria-label="Back to top"
      >
        <span class="text-[9px] tracking-[0.3em] uppercase opacity-0 group-hover:opacity-100 transition-opacity">TOP</span>
        <div class="p-3 border border-white/10 group-hover:border-white/30 rounded-full transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 transition-transform group-hover:-translate-y-1">
                <path d="m18 15-6-6-6 6"/>
            </svg>
        </div>
      </button>
    </div>
  </div>
</footer>

<script>
  // 处理回到顶部点击事件
  const backToTopBtn = document.getElementById('back-to-top');
  if (backToTopBtn) {
    backToTopBtn.addEventListener('click', () => {
      window.scrollTo({
        top: 0,
        behavior: 'smooth' // 平滑滚动
      });
    });
  }
</script>