---
const { title, clients } = Astro.props
---

<section class="anim-wrapper bs-container bs-mt-lg">

  { title && <h2 class="bs-h2 text-center mb-12" set:html={ title } />}

  <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-6">

     {
      clients.map( item => (
        <a 
          href={ item.link } 
          target="_blank" 
          class="group flex flex-col items-center justify-center p-6 rounded-xl bg-bs-surface-2/30 hover:bg-bs-surface-2 transition-all duration-500 border border-transparent hover:border-white/10"
        >
          <div class="h-10 flex items-center justify-center">
            <img
              src={ item.image }
              alt={ item.title }
              /* 核心修复：h-6 保持精致，w-auto 配合 object-contain 拒绝变形 */
              class="h-6 w-auto object-contain opacity-40 group-hover:opacity-100 transition-all duration-500 ease-in-out"
              loading="lazy"
            />
          </div>

          <span class="mt-3 text-[10px] uppercase tracking-[0.2em] text-gray-500 opacity-50 group-hover:opacity-100 group-hover:text-white transition-all duration-500">
            { item.title }
          </span>
        </a>
      ))
    }

  </div>

</section>