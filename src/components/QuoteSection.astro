---
const { content, cite, role } = Astro.props
---

<blockquote class="bs-container bs-mt-lg font-display text-3xl md:text-5xl lg:text-6xl flex flex-col gap-6" id="quote">
  <div set:html={content} class="text-bs-foreground-dark bs-st-quote [&_strong]:font-normal font-display" />

  <cite class="not-italic">
    <div class="flex flex-col md:flex-row md:items-baseline gap-2 md:gap-4">
      <span class="font-serif font-bold tracking-widest text-bs-foreground-light text-4xl md:text-5xl">
        {cite}
      </span>
      <span class="text-bs-foreground-dark text-xl md:text-2xl opacity-70">
        / {role}
      </span>
    </div>
  </cite>
</blockquote>

<style is:global>
  /* 这里的动画保留了滚动时文字亮起的交互感 */
  @keyframes white-text {
    to {
      color: var(--color-bs-foreground-light);
    }
  }

  @supports (animation-timeline: view()) {
    .bs-st-quote strong {
      animation: white-text linear;
      animation-timeline: view(20% block);
      animation-fill-mode: forwards;
    }
  }

  @supports (not (animation-timeline: view())) {
    .bs-st-quote strong {
      color: var(--color-bs-foreground-light);
    }
  }
</style>