---
import X from '../assets/theme-images/icon-x.svg'
const { content } = Astro.props
---

<dialog id="demo" class="fixed inset-0 bg-bs-surface-0 m-auto z-50 p-6 md:p-12 rounded-xl w-full max-w-[95%] md:max-w-lg border border-white/10 shadow-2xl">
  <form id="enquiryForm" class="flex gap-6 flex-col">
    <h2 class="text-2xl flex justify-between items-center gap-4 text-white font-display text-balance">
      <span>{content.title}</span>
      <button type="button" onclick="this.closest('dialog').close()" aria-label="Close" class="bs-btn rounded-full p-0! flex items-center justify-center h-10 w-10 hover:bg-white/10 transition-colors">
        <X class="scale-75 opacity-75" width="32" height="32" />
      </button>
    </h2>

    <div class="flex flex-col gap-4">
      <div id="formContent" class="flex flex-col gap-4">
        <div class="bs-body-text mb-3 text-white/70" set:html={content.content} />
        
        <div class="flex flex-col gap-3">
          <input id="userName" required type="text" class="border-2 rounded-lg bg-bs-surface-0 border-bs-surface-3 form-input px-4 py-3 text-white focus:border-white/50 outline-none transition-all placeholder:text-white/30" placeholder="您的姓名 / 负责人" />
          
          <input id="userCompany" type="text" class="border-2 rounded-lg bg-bs-surface-0 border-bs-surface-3 form-input px-4 py-3 text-white focus:border-white/50 outline-none transition-all placeholder:text-white/30" placeholder="公司名称 (选填)" />
          
          <input id="userContact" required type="text" class="border-2 rounded-lg bg-bs-surface-0 border-bs-surface-3 form-input px-4 py-3 text-white focus:border-white/50 outline-none transition-all placeholder:text-white/30" placeholder="您的手机号或微信号" />
          
          <button id="submitBtn" type="submit" class="bs-btn form-input px-4 py-3 bg-white text-black font-bold hover:bg-gray-200 active:scale-[0.98] transition-all mt-2">
            {content.cta}
          </button>
        </div>
      </div>
      
      <div id="successArea" class="hidden flex flex-col items-center gap-8 py-6 animate-in">
        <div class="text-center space-y-3">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-white/5 mb-2 border border-white/10">
            <span class="text-xl">⚙️</span>
          </div>
          <p class="text-white text-xl font-bold tracking-tight">需求已录入 5F 增长系统</p>
          <p class="text-white/50 text-sm max-w-[280px] mx-auto">我们的**数字化工程师**将在 24 小时内与您对接。</p>
        </div>

        <div class="w-full h-[1px] bg-white/10"></div>

        <div class="text-center space-y-4 w-full">
          <p class="text-[10px] text-white/40 uppercase tracking-[0.2em]">技术直连通道</p>
          <button type="button" id="copyBtn" class="flex items-center justify-center gap-2 w-full py-4 bg-white text-black rounded-xl font-bold hover:bg-gray-200 active:scale-[0.96] transition-all shadow-lg">
              <span id="copyBtnText">一键复制工程师微信号</span>
          </button>
          <p class="text-[11px] text-white/30 font-mono">ID: socks-industry</p>
        </div>
      </div>
    </div>
  </form>
</dialog>

<script define:vars={{ webhookUrl: "https://open.feishu.cn/open-apis/bot/v2/hook/b70e4a05-d0aa-47a6-9bdb-0e10383a1f8e" }}>
  const form = document.getElementById('enquiryForm');
  const formContent = document.getElementById('formContent');
  const successArea = document.getElementById('successArea');
  const btn = document.getElementById('submitBtn');
  const copyBtn = document.getElementById('copyBtn');
  const copyBtnText = document.getElementById('copyBtnText');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    btn.innerText = "数据传输中...";
    btn.disabled = true;

    // 改动点：处理公司名称空值逻辑
    const companyVal = document.getElementById('userCompany').value.trim() || "（未填写）";

    const payload = {
      msg_type: "interactive",
      card: {
        header: {
          title: { content: "⚙️ 5F 增长系统 - 新增技术工单", tag: "plain_text" },
          template: "grey"
        },
        elements: [
          { tag: "div", text: { content: `**负责人：** ${document.getElementById('userName').value}`, tag: "lark_md" } },
          { tag: "div", text: { content: `**主体公司：** ${companyVal}`, tag: "lark_md" } },
          { tag: "div", text: { content: `**联络凭证：** ${document.getElementById('userContact').value}`, tag: "lark_md" } },
          { tag: "hr" },
          { tag: "note", elements: [{ content: `来自：ECHO 5F 数字化工厂咨询入口`, tag: "plain_text" }] }
        ]
      }
    };

    try {
      await fetch(webhookUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      formContent.classList.add('hidden');
      successArea.classList.remove('hidden');
    } catch (error) {
      alert("系统繁忙，请直接添加工程师微信：socks-industry");
      btn.disabled = false;
      btn.innerText = "重试录入";
    }
  });

  // 复制微信号逻辑
  copyBtn?.addEventListener('click', () => {
    const wechatId = 'socks-industry';
    navigator.clipboard.writeText(wechatId).then(() => {
      const originalText = copyBtnText.innerText;
      copyBtnText.innerText = "✅ 微信号已复制";
      copyBtn.style.backgroundColor = "#e5e7eb";
      
      setTimeout(() => {
        copyBtnText.innerText = originalText;
        copyBtn.style.backgroundColor = "#ffffff";
      }, 2000);
    }).catch(err => {
      alert("请手动复制：socks-industry");
    });
  });
</script>

<style>
  .animate-in {
    animation: slideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @keyframes slideUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  
  dialog[open]::backdrop {
    background: rgba(0, 0, 0, 0.9);
    backdrop-filter: blur(12px);
  }
</style>