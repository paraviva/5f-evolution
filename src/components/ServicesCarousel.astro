---
import Arrow from '../assets/theme-images/icon-arrow.svg'

const { title, services } = Astro.props
---

<section id="services" class="bs-mt-lg overflow-hidden">
  <header class="bs-container flex items-center justify-between mb-8">
    {title && <h2 class="bs-h2 text-white">{title}</h2>}

    <nav class="bs-st-button-wrapper flex justify-center gap-4">
      <button aria-label="Previous slide" class="js-fc-btn-prev group bs-btn rounded-full p-0! flex items-center justify-center h-10 w-10 md:h-12 md:w-12 border border-white/10 hover:bg-white/5 transition-all cursor-pointer">
        <Arrow class="opacity-60 h-4 w-4 -translate-x-[2px] group-active:translate-y-px" height="16" width="25" />
      </button>

      <button aria-label="Next slide" class="js-fc-btn-next group bs-btn rounded-full p-0! flex items-center justify-center h-10 w-10 md:h-12 md:w-12 -scale-x-100 border border-white/10 hover:bg-white/5 transition-all cursor-pointer">
        <Arrow class="opacity-60 h-4 w-4 -translate-x-[2px] group-active:translate-y-px" height="16" width="25" />
      </button>
    </nav>
  </header>

  <div class="js-fc-swiper swiper select-none">
    <div class="swiper-wrapper">
      {
        services.map((item) => (
          <div class="swiper-slide bg-bs-surface-0 border border-bs-surface-3 rounded-2xl overflow-hidden h-auto!">
            <figure class="flex flex-col gap-6 isolate min-h-[60svh] md:min-h-[35rem] h-full relative group">
              
              {/* 背景图 */}
              <img 
                src={item.image} 
                alt={item.title} 
                loading="lazy" 
                class="opacity-50 md:opacity-80 rounded-xl overflow-hidden w-full h-full object-cover object-center absolute inset-0 transition-transform duration-1000 group-hover:scale-105" 
              />

              {/* 渐变层 */}
              <div class="absolute inset-0 bg-linear-to-r from-black/90 via-black/30 to-transparent" />

              {/* Content：5F 核心文案 */}
              <figcaption class="z-10 p-8 sm:p-12 md:p-20 max-w-2xl flex flex-col gap-6 h-full justify-center">
                <h3 class="text-3xl md:text-5xl font-bold text-white tracking-tight leading-tight" set:html={item.title} />
                
                <div class="text-gray-300 text-lg leading-relaxed max-w-lg" set:html={item.content} />

                {/* ✅ 已修复：点击按钮触发询盘弹窗 */}
                <button 
                  type="button" 
                  class="bs-btn inline-block self-start mt-4 px-8 py-3 bg-white/10 hover:bg-white/20 border border-white/10 rounded-lg transition-all text-sm font-bold tracking-widest uppercase cursor-pointer"
                  onclick="demo.showModal()"
                >
                  {item.cta}
                </button>
              </figcaption>
            </figure>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  import Swiper from 'swiper'
  import { Navigation, Autoplay } from 'swiper/modules' 
  import 'swiper/css'

  const initSwiper = () => {
    // 检查是否已经存在实例，防止重复初始化导致按钮失效
    const swiperEl = document.querySelector('.js-fc-swiper');
    if (!swiperEl) return;
    
    // @ts-ignore
    if (swiperEl.swiper) swiperEl.swiper.destroy();

    new Swiper('.js-fc-swiper', {
      modules: [Navigation, Autoplay],
      slidesPerView: 1.1,
      spaceBetween: 16,
      speed: 800,
      loop: true,
      centeredSlides: true,
      autoplay: {
        delay: 5000,
        disableOnInteraction: false,
      },
      navigation: {
        nextEl: '.js-fc-btn-next',
        prevEl: '.js-fc-btn-prev',
      },
      breakpoints: {
        '768': {
          slidesPerView: 1.2,
          spaceBetween: 32,
        },
        '1280': {
          slidesPerView: 1.4,
          spaceBetween: 48,
        }
      },
    })
  }

  // 1. 首次加载执行
  initSwiper();
  // 2. 监听 Astro 生命周期
  document.addEventListener('astro:page-load', initSwiper);
  document.addEventListener('astro:after-swap', initSwiper);
</script>