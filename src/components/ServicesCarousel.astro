---
import Arrow from '../assets/theme-images/icon-arrow.svg'

// 注意：这里的变量名要和你传入的 props 一致，如果是从 JSON 读的，建议叫 services
const { title, services } = Astro.props
---

<section id="services" class="bs-mt-lg">
  <header class="bs-container flex items-center justify-between mb-8">
    {title && <h2 class="bs-h2">{title}</h2>}

    <nav class="bs-st-button-wrapper flex justify-center gap-4">
      <button aria-label="Previous slide" class="js-fc-btn-prev group bs-btn rounded-full p-0! flex items-center justify-center h-10 w-10 md:h-12 md:w-12 border border-white/10 hover:bg-white/5 transition-all">
        <Arrow class="opacity-60 h-4 w-4 -translate-x-[2px] group-active:translate-y-px" height="16" width="25" />
      </button>

      <button aria-label="Next slide" class="js-fc-btn-next group bs-btn rounded-full p-0! flex items-center justify-center h-10 w-10 md:h-12 md:w-12 -scale-x-100 border border-white/10 hover:bg-white/5 transition-all">
        <Arrow class="opacity-60 h-4 w-4 -translate-x-[2px] group-active:translate-y-px" height="16" width="25" />
      </button>
    </nav>
  </header>

  <div class="js-fc-swiper swiper select-none">
    <div class="swiper-wrapper">
      {
        /* 这里直接循环 services，Swiper 开启 loop 会自动处理 */
        services.map((item) => (
          <div class="swiper-slide bg-bs-surface-0 border border-bs-surface-3 rounded-2xl overflow-hidden h-auto!">
            <figure class="flex flex-col gap-6 isolate min-h-[60svh] md:min-h-[35rem] h-full relative group">
              
              {/* 背景图：去掉 grayscale（灰度），调高不透明度，增加悬停缩放 */}
              <img 
                src={item.image} 
                alt={item.title} 
                loading="lazy" 
                class="opacity-40 md:opacity-90 rounded-xl overflow-hidden w-full h-full object-cover object-center absolute inset-0 transition-transform duration-1000 group-hover:scale-105" 
              />

              {/* 渐变层：确保文字清晰，同时保留图片质感 */}
              <div class="absolute inset-0 bg-linear-to-r from-black/90 via-black/40 to-transparent" />

              {/* Content：5F 核心文案 */}
              <figcaption class="z-10 p-8 sm:p-12 md:p-20 max-w-2xl flex flex-col gap-6 h-full justify-center">
                <h3 class="text-3xl md:text-5xl font-bold text-white tracking-tight" set:html={item.title} />
                
                <div class="text-gray-300 text-lg leading-relaxed max-w-lg" set:html={item.content} />

                <button type="button" class="bs-btn inline-block self-start mt-4 px-8 py-3 bg-white/10 hover:bg-white/20 border border-white/10 rounded-lg transition-all text-sm font-bold tracking-widest uppercase">
                  {item.cta}
                </button>
              </figcaption>
            </figure>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  import Swiper from 'swiper'
  import { Navigation } from 'swiper/modules' // 引入导航模块
  import 'swiper/css'

  const initSwiper = () => {
    const swiper = new Swiper('.js-fc-swiper', {
      modules: [Navigation],
      slidesPerView: 1.1,
      spaceBetween: 16,
      speed: 800,
      loop: true,
      centeredSlides: true,
      navigation: {
        nextEl: '.js-fc-btn-next',
        prevEl: '.js-fc-btn-prev',
      },
      breakpoints: {
        '768': {
          slidesPerView: 1.2,
          spaceBetween: 32,
        },
        '1280': {
          slidesPerView: 1.4,
          spaceBetween: 48,
        }
      },
    })
  }

  // 确保在 Astro 页面加载时初始化
  initSwiper();
  document.addEventListener('astro:after-swap', initSwiper);
</script>