---
import { getCollection, render } from 'astro:content'
import Layout from '../../../layouts/Layout.astro'
import { getPillar, getCategory } from '../../../data/taxonomy'
import globalSettings from '../../../data/global_settings.json'
const base = globalSettings.base_url

export async function getStaticPaths() {
  const entries = await getCollection('guides')
  return entries
    .map((entry) => {
      const parts = entry.id.split('/')
      if (parts.length !== 3) return null
      const [f, category, slug] = parts
      return { params: { f, category, slug }, props: { entry } }
    })
    .filter(Boolean) as any[]
}

const { entry } = Astro.props
const { Content } = await render(entry)
const [f, category, slug] = entry.id.split('/')
const pillar = getPillar(f)!
const cat = getCategory(f, category)!
const url = `/${f}/${category}/${slug}/`
const crumbs = [
  { name: 'Home', url: '/' },
  { name: pillar.name, url: `/${f}/` },
  { name: cat.name, url: `/${f}/${category}/` },
  { name: entry.data.title, url },
]

const all = await getCollection('guides')
const related = all
  .filter((g) => g.data.f === f && g.data.category === category && g.id !== entry.id)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4)
---

<Layout title={entry.data.title + ' | 5F GEO'} description={entry.data.description}>
  <Fragment slot="head">
    <link rel="canonical" href={`${base}${url}`} />
    <link rel="alternate" hreflang="en" href={`${base}${url}`} />
    <link rel="alternate" hreflang="x-default" href={`${base}${url}`} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: base + c.url })),
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org', '@type': 'Article',
      headline: entry.data.title, description: entry.data.description,
      dateModified: entry.data.updated || new Date().toISOString().slice(0, 10),
      author: { '@type': 'Organization', name: '5F GEO' },
      mainEntityOfPage: { '@type': 'WebPage', '@id': base + url },
    })} />
  </Fragment>

  <main class="bs-container bs-mt-lg f-article-wrap">
    <nav class="f-breadcrumb">
      {crumbs.map((c, i) => (<span>{i > 0 && ' / '}<a href={c.url}>{c.name}</a></span>))}
    </nav>

    <header class="f-article-head">
      <span class="f-pillar-tag">{pillar.name} · {cat.name}</span>
      <h1 class="bs-h2">{entry.data.title}</h1>
      <p class="f-lede">{entry.data.description}</p>
    </header>

    <article class="f-prose">
      <Content />
    </article>

    {related.length > 0 && (
      <section class="f-related">
        <h2>相关主题</h2>
        <ul>
          {related.map((r) => (
            <li><a href={`/${f}/${category}/${r.id.split('/')[2]}/`}>{r.data.title}</a></li>
          ))}
        </ul>
      </section>
    )}

    <section class="f-cta">
      <h2>需要把这套方法落到你的业务？</h2>
      <p>预约 5F 系统拆解，获取定制化的数字化外贸获客方案。</p>
      <button class="bs-btn" onclick="demo.showModal()">获取增长方案</button>
    </section>
  </main>
</Layout>

<style is:global>
  .f-article-wrap { max-width: 820px; }
  .f-article-head { margin-bottom: 2rem; }
  .f-article-head .bs-h2 { margin: .5rem 0 .75rem; }
  .f-lede { color: #cfcfcf; font-size: 1.1rem; line-height: 1.7; margin: 0; }
  .f-prose { color: #dcdcdc; line-height: 1.85; font-size: 1.02rem; }
  .f-prose h2 { color: #fff; font-size: 1.5rem; margin: 2.2rem 0 .8rem; }
  .f-prose h3 { color: #fff; font-size: 1.2rem; margin: 1.6rem 0 .6rem; }
  .f-prose p { margin: 0 0 1.1rem; }
  .f-prose ul, .f-prose ol { margin: 0 0 1.1rem; padding-left: 1.4rem; }
  .f-prose li { margin: .35rem 0; }
  .f-prose a { color: #4ea1ff; text-decoration: underline; text-underline-offset: 3px; }
  .f-prose code { background: #1f1f24; padding: .15rem .4rem; border-radius: 5px; font-size: .9em; color: #ffd479; }
  .f-prose pre { background: #0d0d10; border: 1px solid #2F2F31; border-radius: 10px; padding: 1rem; overflow: auto; }
  .f-prose pre code { background: none; color: #dcdcdc; }
  .f-prose blockquote { border-left: 3px solid #4ea1ff; margin: 1.2rem 0; padding: .4rem 1rem; color: #9f9f9f; }
  .f-related { margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid #2F2F31; }
  .f-related h2 { color: #fff; font-size: 1.2rem; margin: 0 0 1rem; }
  .f-related ul { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: .75rem; }
  .f-related a { display: inline-block; padding: .5rem .9rem; background: #121212; border: 1px solid #2F2F31; border-radius: 999px; color: #cfcfcf; text-decoration: none; font-size: .9rem; }
  .f-related a:hover { border-color: #4ea1ff; color: #4ea1ff; }
  .f-cta { margin-top: 3rem; padding: 2rem; background: linear-gradient(135deg,#121212,#1a1a1f); border: 1px solid #2F2F31; border-radius: 18px; text-align: center; }
  .f-cta h2 { margin: 0 0 .5rem; color: #fff; }
  .f-cta p { color: #9f9f9f; margin: 0 0 1.25rem; }
</style>
